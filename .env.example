APP_NAME="CareerConnect"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://careerconnect.deoris.net
APP_PORTAL_URL=https://deoris.net
AUTH_SERVICE_URL=https://deoris.net
DEORIS_PORTAL_URL=https://deoris.net

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=careerconnect
DB_USERNAME=careerconnect
DB_PASSWORD=change-me-db-password

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.deoris.net
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=none

REVERB_APP_ID=careerconnect
REVERB_APP_KEY=change-me-careerconnect-reverb-key
REVERB_APP_SECRET=change-me-careerconnect-reverb-secret
REVERB_HOST=deoris.net
REVERB_PORT=443
REVERB_SCHEME=https

CAREERCONNECT_SERVICE_NAME=careerconnect-service
CAREERCONNECT_DISPLAY_NAME=CareerConnect
CAREERCONNECT_SERVICE_VERSION=1.0.0
CAREERCONNECT_API_VERSION=v1
CAREERCONNECT_URL=https://careerconnect.deoris.net
CAREERCONNECT_SERVICE_KEY=careerconnect-service-key
CAREERCONNECT_EVENT_SECRET=change-me-careerconnect
CAREERCONNECT_SEARCH_TOKEN=change-me-careerconnect-search-token
CAREERCONNECT_API_RATE_LIMIT=120
EVENT_HUB_URL=https://deoris.net/api/events
EVENT_HUB_SECRET=change-me-careerconnect

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@careerconnect.deoris.net"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
