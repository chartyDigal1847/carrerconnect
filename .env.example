APP_NAME="CareerConnect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://careerconnect.local
APP_PORTAL_URL=https://deoris.test
AUTH_SERVICE_URL=https://deoris.test
DEORIS_PORTAL_URL=https://deoris.test

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=careerconnect
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=careerconnect_session
SESSION_DOMAIN=.deoris.test
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=none

REVERB_APP_ID=careerconnect
REVERB_APP_KEY=careerconnect-key
REVERB_APP_SECRET=careerconnect-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

CAREERCONNECT_SERVICE_NAME=careerconnect-service
CAREERCONNECT_DISPLAY_NAME=CareerConnect
CAREERCONNECT_SERVICE_VERSION=1.0.0
CAREERCONNECT_API_VERSION=v1
CAREERCONNECT_URL=http://careerconnect.local
CAREERCONNECT_SERVICE_KEY=careerconnect-service-key-secret
CAREERCONNECT_EVENT_SECRET=change-me-careerconnect
CAREERCONNECT_SEARCH_TOKEN=change-me-careerconnect-search-token
CAREERCONNECT_API_RATE_LIMIT=120
EVENT_HUB_URL=http://event-hub.local/api/v1
EVENT_HUB_SECRET=event-hub-secret-key

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

